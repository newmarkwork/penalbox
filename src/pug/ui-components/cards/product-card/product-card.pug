include ../../sliders/product-card-inner-slider/product-card-inner-slider

mixin product-card(data)
  a(href="#").product-card
    .product-card__header
      +product-card-inner-slider(data.items)
    .product-card__content
      span.product-card__title!= data.title
      if data.price
        span.product-card__price
          small от&nbsp;
          != data.price
          small &nbsp;руб.
      span.product-card__text!= data.text

